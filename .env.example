# Server-only values. Fill .env locally or the host's secret manager; never put keys in dist.
OPENAI_API_KEY=
OPENAI_MODEL=
# Private classroom code, 12–200 ASCII letters/digits/underscore/hyphen; this is not the provider API key.
PET_ACCESS_CODE=
# Exact origins, comma separated, no wildcard or path.
PET_ALLOWED_ORIGINS=
PET_MAX_CALLS_PER_HOUR=120
PET_MAX_CONCURRENT=3
PET_TIMEOUT_MS=10000
