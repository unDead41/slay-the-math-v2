  "runtime_core_definitions": {
    "focus": "A resource capped at 3. Spend 1 Focus to add 3 damage or Block to one card, once per turn. A first-try correct Predict grants 1 Focus.",
    "strength": "Adds its value to the damage of each Attack card before enemy defenses. It resets each combat.",
    "agility": "Adds its value to Block gained from each Defense card. It resets each combat. Block from Attack cards does not get Agility.",
    "defend": "Defense is the game label for Defend cards, such as Guard. These cards receive Agility and first-Defend bonuses.",
    "draw": "Move available cards from Draw Pile into Hand. If Draw Pile is empty, shuffle Discard into it. There is no Hand cap; an empty Draw Pile and Discard stop the draw.",
    "block": "Temporary protection that absorbs incoming damage. Player Block resets to 0 at the start of the next player turn, before artifact additions.",
    "damage": "Sealed bosses halve incoming damage, rounded up, before enemy Block. Any remaining damage reduces HP. A sealed boss remains at least 1 HP until its seals open.",
    "passive": "A card type for ongoing effects. This version has no Passive cards, so artifacts requiring them are excluded from offers.",
    "d6": "A six-sided die with results 1 to 6. Chance Die rolls once on the separate saved artifact random stream; viewing it never rolls again."
  },
  "example_snapshots_bundled_in_runtime": false
}
