  "voiceSequences": {
    "dungeonMaster": {
      "orderedVoiceIds": [
        "vo_dm_01",
        "vo_dm_02",
        "vo_dm_03",
        "vo_dm_04"
      ],
      "orderStatus": "DISAHKAN",
      "counterScope": "per_run",
      "counterScopeStatus": "CADANGAN",
      "resetOnNewRun": true,
      "retainAcrossStages": true,
      "overflowPolicy": "hold_last",
      "overflowPolicyStatus": "CADANGAN",
      "selectionFormula": "orderedVoiceIds[Math.min(visitNumber, 4) - 1]",
      "reopenSameEncounter": "replay_same_voice_once_per_surface_activation_without_increment",
      "reopenStatus": "CADANGAN",
      "countWhenMuted": true,
      "countWhenMutedStatus": "CADANGAN",
      "trigger": "artifact_choice_surface_enter",
      "encounterKey": "artifact:${offer.source}",
      "eligibility": "actual gift-choice panel visible, offer.ready true and choices nonempty; exclude paid Shop stock and education"
    },
    "merchant": {
      "orderedVoiceIds": [
        "vo_shop_01",
        "vo_shop_02",
        "vo_shop_03"
      ],
      "orderStatus": "DISAHKAN",
      "counterScope": "per_run",
      "counterScopeStatus": "CADANGAN",
      "resetOnNewRun": true,
      "retainAcrossStages": true,
      "overflowPolicy": "hold_last",
      "overflowPolicyStatus": "CADANGAN",
      "selectionFormula": "orderedVoiceIds[Math.min(visitNumber, 3) - 1]",
      "reopenSameEncounter": "replay_same_voice_once_per_surface_activation_without_increment",
      "reopenStatus": "CADANGAN",
      "countWhenMuted": true,
      "countWhenMutedStatus": "CADANGAN",
      "trigger": "shop_surface_enter",
      "encounterKey": "shop:${run.stage}:${run.route.active ?? run.depth}",
      "eligibility": "actual Shop visit; tabs and purchases are not new visits"
    }
  },
  "routePriority": [
    {
      "when": "ui.home || !run",
      "existingCue": "menu",
      "behavior": "retain_existing"
    },
    {
      "when": "visibleSurface === artifact_choice",
      "existingCue": "mystery",
      "behavior": "temporary_existing_fallback_no_new_artifact_bgm_supplied"
    },
    {
      "when": "visibleSurface === education",
      "existingCue": "mystery",
      "behavior": "retain_existing_without_voice"
    },
    {
      "when": "run.scene === defeat",
      "assetId": "bgm_defeat"
    },
    {
      "when": "run.scene === battle && enemy.boss && run.stage === 0",
      "assetId": "bgm_boss_stage_1"
    },
    {
      "when": "run.scene === battle && enemy.boss && run.stage === 1",
      "assetId": "bgm_boss_stage_2"
    },
    {
      "when": "run.scene === battle && !enemy.boss && run.stage === 0",
      "assetId": "bgm_combat_stage_1"
    },
    {
      "when": "run.scene === battle && !enemy.boss && run.stage === 1",
      "assetId": "bgm_combat_stage_2"
    },
    {
      "when": "run.scene === shop",
      "assetId": "bgm_shop"
    },
    {
      "when": "run.scene === camp",
      "assetId": "bgm_rest"
    },
    {
      "when": "run.scene === map",
      "assetId": "bgm_map"
    },
    {
      "when": "other scenes",
      "behavior": "retain_existing_route_without_inventing_new_cues"
    }
  ],
  "proposedMix": {
    "status": "CADANGAN_tuning",
    "musicDefault": 0.45,
    "sfxDefault": 0.65,
    "voiceDefault": 0.85,
    "maximumActiveVoices": 1,
    "musicCrossfadeMilliseconds": 850,
    "voiceFadeOutMilliseconds": 80,
    "voiceDuckingFactor": 0.3,
    "duckAttackMilliseconds": 150,
    "duckReleaseMilliseconds": 350,
    "duckCombination": "minimum_factor_not_multiplication",
    "globalMuteAffects": [
      "music",
      "voice",
      "sfx"
    ],
    "separateVoiceVolume": true
  },
  "encounterState": {
    "status": "CADANGAN_not_implemented",
    "field": "run.audioPresentation",
    "schemaVersion": 1,
    "versioning": "optional_additive_metadata_keep_gameplay_state_authoritative",
    "countersIndependent": [
      "dungeonMaster",
      "merchant"
    ],
    "incrementRule": "once_per_new_visible_encounter_key_before_playback_even_if_muted_or_decode_fails",
    "persist": [
      "encounter key",
      "speaker",
      "visit number",
      "selected voice id"
    ],
    "neverPersist": [
      "AudioContext",
      "AudioNode",
      "buffer",
      "timer",
      "surface activation token",
      "playback offset"
    ],
    "checkpointPolicy": "restore_metadata_snapshot_with_its_owning_checkpoint",
